# udev rules for dfu-programmer: let the logged-in user reach the
# bootloaders it supports, so it runs without root.
# Generated by `dfu-programmer --targets-udev`. Don't edit by hand.

# at89c51snd1c, at89c51snd2c, at89c5132
SUBSYSTEM=="usb", ATTR{idVendor}=="03eb", ATTR{idProduct}=="2fff", TAG+="uaccess"

